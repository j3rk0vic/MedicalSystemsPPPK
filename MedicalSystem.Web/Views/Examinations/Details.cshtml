@model MedicalSystem.Web.Models.Entities.Examination
@{
    ViewData["Title"] = "Examination Details";
    var medications = ViewBag.Medications as List<MedicalSystem.Web.Models.Entities.Medication>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Examination — @Model.Type</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light"><strong>Patient Details</strong></div>
            <div class="card-body">
                @if (Model.Patient != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.Patient.FirstName @Model.Patient.LastName</dd>

                        <dt class="col-sm-4">OIB:</dt>
                        <dd class="col-sm-8">@Model.Patient.Oib</dd>
                    </dl>
                    <hr />
                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.Patient.Id" 
                       class="btn btn-sm btn-info text-white">View Full Patient Profile</a>
                }
                else
                {
                    <p class="text-muted mb-0">Patient information not loaded (ID: @Model.PatientId).</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light"><strong>Clinical Information</strong></div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Type:</dt>
                    <dd class="col-sm-9">@Model.Type</dd>

                    <dt class="col-sm-3">Date:</dt>
                    <dd class="col-sm-9">@Model.Date.ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-3">Diagnosis:</dt>
                    <dd class="col-sm-9">@Model.Diagnosis</dd>

                    <dt class="col-sm-3">Notes:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Notes) ? "No notes provided." : Model.Notes)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span><strong>Prescriptions (@(Model.Prescriptions?.Count ?? 0))</strong></span>
    </div>
    <div class="card-body">
        @if (Model.Prescriptions != null && Model.Prescriptions.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Medication</th>
                            <th>Dosage</th>
                            <th>Frequency</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prescription in Model.Prescriptions)
                        {
                            var med = medications?.FirstOrDefault(m => m.Id == prescription.MedicationId);
                            <tr>
                                <td class="fw-bold text-primary">
                                    @(med?.Name ?? $"ID: {prescription.MedicationId}")
                                </td>
                                <td>@prescription.Dosage</td>
                                <td>@prescription.Frequency</td>
                                <td>@prescription.DurationDays Days</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-3">
                <p class="text-muted mb-0">No prescriptions recorded for this examination.</p>
            </div>
        }
    </div>
</div>