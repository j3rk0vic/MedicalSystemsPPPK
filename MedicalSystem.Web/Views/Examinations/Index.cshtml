@model IEnumerable<MedicalSystem.Web.Models.Entities.Examination>
@{
    ViewData["Title"] = "Examinations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Examinations</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> + Add Examination
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Patient</th>
                <th>Type</th>
                <th>Date</th>
                <th>Diagnosis</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var exam in Model)
                {
                    <tr>
                        <td>@exam.Id</td>
                        <td>
                            @if (exam.Patient != null)
                            {
                                @($"{exam.Patient.FirstName} {exam.Patient.LastName}")
                            }
                            else
                            {
                                <span class="text-muted">ID: @exam.PatientId</span>
                            }
                        </td>
                        <td>@exam.Type</td>
                        <td>@exam.Date.ToString("dd.MM.yyyy")</td>
                        <td class="text-truncate" style="max-width: 200px;">@exam.Diagnosis</td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@exam.Id" class="btn btn-sm btn-info text-white">Details</a>
                                <a asp-action="Edit" asp-route-id="@exam.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@exam.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No examinations found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>