@model MedicalSystem.Web.Models.Entities.Patient
@{ ViewData["Title"] = "Edit Patient"; }

<h2>Edit Patient</h2>
<hr />

<form method="post" style="max-width: 500px;">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">First Name</label>
        <input type="text" name="FirstName" class="form-control"
               value="@Model.FirstName" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Last Name</label>
        <input type="text" name="LastName" class="form-control"
               value="@Model.LastName" required />
    </div>
    <div class="mb-3">
        <label class="form-label">OIB</label>
        <input type="text" name="Oib" class="form-control"
               value="@Model.Oib" maxlength="11" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Date of Birth</label>
        <input type="date" name="DateOfBirth"
               class="form-control"
               value="@Model.DateOfBirth.ToString("yyyy-MM-dd")"
               required />
    </div>
    <button type="submit" class="btn btn-warning">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>